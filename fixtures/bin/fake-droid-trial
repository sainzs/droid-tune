#!/bin/sh
set -u

MODE="${FAKE_DROID_MODE:-pass}"

if [ "${1:-}" != "exec" ]; then
  echo "0.197.0-fake (trial)"
  exit 0
fi

shift
MODEL=""
CWD=""
TAG=""

while [ $# -gt 0 ]; do
  case "$1" in
    -m|--model) MODEL="${2:-}"; shift 2 ;;
    --cwd) CWD="${2:-}"; shift 2 ;;
    --tag) TAG="${2:-}"; shift 2 ;;
    *) shift ;;
  esac
done

case "$MODE" in
  fail)
    echo "fake droid failure" >&2
    exit 3
    ;;
  hang)
    sleep 60
    exit 0
    ;;
esac

NOW="$(date -u +%Y-%m-%dT%H:%M:%S.000Z)"
if [ -n "${FAKE_DROID_SESSIONS_DIR:-}" ]; then
  SDIR="${FAKE_DROID_SESSIONS_DIR}/-trial-$$"
  mkdir -p "$SDIR"
  SID="$(date +%s)$$"
  printf '{"model":"%s","reasoningEffort":"high","tags":[{"name":"%s"}],"tokenUsage":{"inputTokens":100,"outputTokens":50,"cacheReadTokens":10,"cacheCreationTokens":5,"thinkingTokens":0,"factoryCredits":0}}\n' "$MODEL" "$TAG" > "$SDIR/$SID.settings.json"
  printf '{"type":"session_start","version":"0.197.0","cwd":"%s","title":"fake","timestamp":"%s"}\n{"type":"message","timestamp":"%s","message":{"role":"assistant","content":"OK"}}\n' "$CWD" "$NOW" "$NOW" > "$SDIR/$SID.jsonl"
fi

if [ "$MODE" = "pass" ]; then
  cat > "$CWD/greet.sh" <<'GREET'
#!/bin/sh
printf 'hello tune-up\n'
GREET
  chmod +x "$CWD/greet.sh"
  git -C "$CWD" add -A
  git -C "$CWD" commit -qm add-greet-script
fi

echo '{"result":"OK"}'
exit 0
